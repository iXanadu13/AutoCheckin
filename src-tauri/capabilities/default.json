{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Permissions for the local AutoCheckin settings window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-get-settings",
    "allow-save-settings",
    "allow-get-today-status",
    "allow-open-checkin-window",
    "allow-mark-checkin-done"
  ]
}